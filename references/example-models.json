    "_basis": "FET bus switch —— 導通時 S/D 兩端直接相連，**確實雙向**。",
    "_note": "OE 高態導通。OE 拉低時 S/D 高阻抗，且內部無輸入緩衝器，因此未使用通道的 S/D 懸空不會造成貫穿電流。",
    "transfer": [
      {"from": ["2"], "to": ["3"], "direction": "bidirectional", "gate": {"all_of": ["1"]}},
      {"from": ["5"], "to": ["6"], "direction": "bidirectional", "gate": {"all_of": ["4"]}},
      {"from": ["8"], "to": ["9"], "direction": "bidirectional", "gate": {"all_of": ["10"]}},
      {"from": ["11"], "to": ["12"], "direction": "bidirectional", "gate": {"all_of": ["13"]}}
    ],
    "control": {
      "1": {"type": "enable", "polarity": "high", "mechanism": "strap"},
      "4": {"type": "enable", "polarity": "high", "mechanism": "strap"},
      "10": {"type": "enable", "polarity": "high", "mechanism": "strap"},
      "13": {"type": "enable", "polarity": "high", "mechanism": "strap"}
    }
  },

